CREATE DATABASE modulo2_unidad1_diseno;
CREATE TABLE  CLIENTES(
IDCLIENTE INT PRIMARY KEY, -- Número entero porque cada cliente tiene un identificador único
NOMBRE VARCHAR(100), -- Texto corto para el nombre del cliente
PERFIL_BIO VARCHAR(150), -- Texto más largo para una breve biografía o notas
FECHA_REGISTRO DATE -- Tipo fecha para registrar el día de alta del cliente
);


USE modulo2_unidad1_diseno;
CREATE TABLE PRODUCTOS(
IDPRODUCTO INT PRIMARY KEY, -- Número entero porque cada producto tiene un identificador único
DESCRIPCION VARCHAR(255),-- Texto largo para permitir nombres o descripciones detalladas
PRECIO DECIMAL (10,2), -- Tipo decimal para manejar valores monetarios con dos decimales
ESTA_ACTIVO TINYINT -- 1 = ACTIVO, 2 = INACTIVO
);

